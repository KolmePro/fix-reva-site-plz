{
  "manifest_version": 3,
  "name": "FIX REVA SITE PLZ!",
  "version": "1.4",
  "description": "Упрощает работу с PIN-кодами на revonline.ru, добавляет автооткрытие карточек в коллекции и быстрые кнопки для PIN-кодов на market.vkplay.ru.",
  "content_scripts": [
    {
      "matches": [
        "https://revonline.ru/pin"
      ],
      "js": [
        "revonline-pins.js"
      ]
    },
    {
      "matches": [
        "https://revonline.ru/collection"
      ],
      "js": [
        "revonline-collection.js"
      ]
    },
    {
      "matches": [
        "https://market.vkplay.ru/*"
      ],
      "js": [
        "vkplay-pins.js"
      ]
    }
  ]
}
